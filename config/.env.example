# OpenClaw 环境变量配置 / OpenClaw Environment Variables Configuration
# 
# 说明 / Instructions:
# 1. 复制此文件到 ~/.openclaw/.env
#    Copy this file to ~/.openclaw/.env
# 
# 2. 将 'your-gemini-api-key-here' 替换为您的实际 API Key
#    Replace 'your-gemini-api-key-here' with your actual API key
# 
# 3. 重新加载环境变量：source ~/.openclaw/.env
#    Reload environment variables: source ~/.openclaw/.env
#
# 获取 API Key / Get API Key:
# https://makersuite.google.com/app/apikey

# ============================================
# Gemini API 配置 / Gemini API Configuration
# ============================================

# Google Gemini API Key (主要使用 / Primary)
GEMINI_API_KEY=your-gemini-api-key-here

# Google API Key (备用名称 / Alternative name)
GOOGLE_API_KEY=your-gemini-api-key-here

# ============================================
# 其他 AI 提供商 / Other AI Providers (Optional)
# ============================================

# OpenAI API Key (可选 / Optional)
# OPENAI_API_KEY=your-openai-key-here

# Anthropic (Claude) API Key (可选 / Optional)
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ============================================
# 安全提示 / Security Notes
# ============================================
# 
# ⚠️ 永远不要将此文件提交到 Git（已在 .gitignore 中）
#    Never commit this file to Git (already in .gitignore)
# 
# ⚠️ 定期轮换您的 API Key
#    Rotate your API keys regularly
# 
# ⚠️ 为不同环境使用不同的 Key
#    Use different keys for different environments

{
  "agents": {
    "defaults": {
      "workspace": "/home/user/.openclaw/workspace",
      "model": {
        "primary": "google/gemini-2.0-flash"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    }
  },
  "models": {
    "mode": "merge"
  }
}
